# Generate a random secret: `openssl rand -base64 32`
AUTH_SECRET=

# Recommended for self-hosted deployments. Set this to the public app origin.
# AUTH_URL=https://chat.example.com

# Required for non-Vercel deployments. Vercel uses OIDC automatically.
# https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=

# https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=

# https://vercel.com/docs/postgres
POSTGRES_URL=

# https://vercel.com/docs/redis
REDIS_URL=
